---
import DevHoverCard from './DevHoverCard'
---

<div class="w-full px-10 md:w-2/3">
  <div class="w-fit">
    <h2
      class="rounded-3xl border border-accent-normal px-3 py-1 text-sm font-semibold text-accent-normal"
    >
      Ubicación
    </h2>
  </div>
  <h2 class="py-4 text-xl font-bold">¿Dónde estamos?</h2>
  <iframe
    class="aspect-auto h-80 w-full rounded-3xl"
    title="Centro Mundi - Google Maps"
    aria-hidden="false"
    loading="lazy"
    src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d358.872128706948!2d-71.25593372636426!3d-29.913411649485102!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x9691cbd655a180cb%3A0xe7db50e14c040b93!2sCentro%20Mundi!5e0!3m2!1sen!2scl!4v1745708697930!5m2!1sen!2scl"
    style="border:0;"
    tabindex="0"></iframe>

  <hr class="my-5" />

  <div
    class="flex flex-col items-center justify-between text-sm text-cgray sm:flex-row lg:text-base"
  >
    <h2 class="sm:text-start">© <span id="year"></span> Centro Mundi</h2>

    <div>
      <span class="sm:text-end">Hecho con 🍵 y código por</span>
      <a
        href="https://www.figonzal.cl"
        target="_blank"
        rel="noopener noreferrer"
        referrerpolicy="no-referrer"
      >
        <DevHoverCard title={'figonzal.cl'} client:visible />
      </a>
    </div>
  </div>
</div>
