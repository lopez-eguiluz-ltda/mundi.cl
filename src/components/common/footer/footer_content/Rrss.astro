---
import logo from '@assets/images/mundi_logo.webp'
import SocialButtons from './SocialButtons.astro'
import { Image } from 'astro:assets'
---

<div class="flex w-full flex-col items-center p-5 md:w-1/3 xl:p-10">
  <Image
    src={logo}
    alt="Logo centro mundi"
    loading="lazy"
    class="w-52 py-2"
    quality={80}
    draggable={false}
  />

  <div class="w-full text-center xl:px-5">
    <p class="text-xs text-pretty text-black lg:text-sm xl:text-base">
      Somos tu centro médico integral, pendientes de potenciar una mirada integradora del sanar,
      crecer y florecer de nuestros usuarios ♥️✨️
    </p>
    <p class="py-2 text-cgray">Creciendo junto a ti</p>
  </div>

  <SocialButtons />
</div>
