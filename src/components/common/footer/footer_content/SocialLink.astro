---
import type { IconType } from "react-icons";

interface Props {
  name: string;
  link: string;
  icon: IconType;
}

const { icon: Icon, link, name } = Astro.props;
---

<a
  href={link}
  class="text-accent-normal border-accent-normal hover:bg-accent-normal rounded-full border-[1px] bg-white p-2 duration-300 ease-in-out hover:text-white"
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Visítanos en ${name}`}
>
  <Icon />
</a>
