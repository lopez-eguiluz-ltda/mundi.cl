---
import type { IconType } from 'react-icons'

interface Props {
  name: string
  link: string
  icon: IconType
}

const { icon: Icon, link, name } = Astro.props
---

<a
  href={link}
  class="rounded-full border-[1px] border-accent-normal bg-white p-2 text-accent-normal duration-300 ease-in-out hover:bg-accent-normal hover:text-white"
  target="_blank"
  rel="noopener noreferrer"
  aria-label={`Visítanos en ${name}`}
>
  <Icon />
</a>
