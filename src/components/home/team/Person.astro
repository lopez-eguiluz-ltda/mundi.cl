---
import type { SocialLinkType } from "@utils/types";
import { FaCircle } from "react-icons/fa6";
import SocialLink from "./PersonSocialLink.astro";
import { Image } from "astro:assets";

interface Props {
  name: string;
  position: string;
  photo: ImageMetadata;
  socials: SocialLinkType[];
}

const { name, position, photo, socials } = Astro.props;
---

<div class="flex flex-col items-start justify-center">
  <div
    class="hover:animate-jiggle hover:animate-duration-1000 hover:animate-iteration-count-infinite relative h-80 w-64 overflow-hidden rounded-3xl shadow-lg ring-4 ring-white ring-offset-2"
  >
    <div
      class="relative h-full w-full transition-transform duration-300 ease-in-out hover:scale-105"
    >
      <Image
        src={photo}
        alt={`Foto perfil ${name}`}
        loading="lazy"
        decoding="async"
        quality={80}
        class="h-full w-full transform rounded-3xl object-cover"
        draggable={false}
      />

      {
        socials.length > 0 && (
          <div class="absolute inset-0 rounded-3xl opacity-0 transition-opacity duration-300 ease-in-out hover:opacity-100">
            <div class="absolute bottom-4 flex h-16 w-full items-center justify-center gap-3 bg-white/40">
              {socials.map((socialLink: SocialLinkType) => (
                <SocialLink icon={socialLink.icon} link={socialLink.link} />
              ))}
            </div>
          </div>
        )
      }
    </div>
  </div>

  <div class="flex items-center gap-3 pt-4">
    <FaCircle className="text-accent-normal" size={8} />
    <h2 class="text-cgray text-sm font-semibold">{position}</h2>
  </div>
  <h2 class="text-xl font-bold text-white">{name}</h2>
</div>
