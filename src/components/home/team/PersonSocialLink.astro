---
import type { IconType } from "react-icons";

interface Props {
  link: string;
  icon: IconType;
}

const { icon: Icon, link } = Astro.props;
---

<a
  class="text-accent-normal hover:bg-accent-normal rounded-full bg-white p-3 duration-300 ease-in-out hover:text-white"
  href={link}
  target="_blank"
  rel="noopener noreferrer"
>
  <Icon size={24} />
</a>
