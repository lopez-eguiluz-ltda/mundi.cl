---
import type { IconType } from 'react-icons'

interface Props {
  link: string
  icon: IconType
}

const { icon: Icon, link } = Astro.props
---

<a
  class="rounded-full bg-white p-3 text-accent-normal duration-300 ease-in-out hover:bg-accent-normal hover:text-white"
  href={link}
  target="_blank"
  rel="noopener noreferrer"
>
  <Icon size={24} />
</a>
