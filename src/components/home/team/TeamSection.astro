---
import { teams } from "@utils/teamsSeed";
import type { TeamType } from "@utils/types";
import Person from "./Person.astro";
---

<!-- Nuestro equipo -->
<section
  class="flex scroll-my-32 flex-col items-start px-10 py-10 select-none md:px-20 md:py-12"
  id="equipo"
>
  <h2
    class="rounded-3xl border border-white px-3 py-1 text-sm font-semibold text-white"
  >
    Conócenos
  </h2>

  <h2 class="pt-4 pb-10 text-2xl font-bold text-white md:text-4xl">
    Nuestros especialistas
  </h2>
  <div
    class="grid w-full grid-cols-1 justify-items-center gap-x-5 gap-y-10 sm:grid-cols-2 lg:grid-cols-3 xl:grid-cols-4 2xl:grid-cols-5"
  >
    {
      teams.map((person: TeamType) => (
        <Person
          name={person.name}
          position={person.position}
          photo={person.photo}
          socials={person.socialLink}
        />
      ))
    }
  </div>
</section>
