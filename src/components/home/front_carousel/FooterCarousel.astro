---
import { FaWhatsapp } from 'react-icons/fa'

import camila from '@assets/images/equipo/camila_eguiluz.webp'
import logo from '@assets/images/mundi_logo_semi_full.webp'
import { RxDoubleArrowDown } from 'react-icons/rx'
import { Image } from 'astro:assets'
---

<section class="relative flex justify-center select-none md:px-10 xl:px-28">
  <div
    class="absolute top-0 right-0 hidden -translate-x-24 -translate-y-28 transform sm:block md:-translate-y-32 lg:-translate-x-40 xl:-translate-x-60"
  >
    <RxDoubleArrowDown
      className="absolute top-0 right-0 z-20 animate-sink text-white animate-duration-1000 animate-iteration-count-infinite"
      size={90}
    />
    <RxDoubleArrowDown
      className="absolute top-2 right-0 z-20 animate-sink text-black opacity-50 animate-duration-1000 animate-iteration-count-infinite"
      size={90}
    />
  </div>

  <div
    class="w-full translate-y-0 bg-white/95 px-10 py-8 shadow-lg transition-all duration-300 ease-in-out md:rounded-b-3xl md:py-4 md:opacity-65 md:hover:-translate-y-5 md:hover:rounded-3xl md:hover:opacity-100 xl:px-20"
  >
    <div class="grid grid-cols-1 items-center md:grid-cols-3 md:space-y-0">
      <div class="order-last flex justify-start md:order-first">
        <a href="#equipo">
          <div class="flex flex-row items-center">
            <div
              class="h-11 w-11 -translate-x-3 overflow-hidden rounded-full border-2 border-primary-light"
            >
              <Image
                src={camila}
                alt="Imagen camila"
                loading="eager"
                class="h-full object-cover"
                draggable={false}
                quality={80}
              />
            </div>

            <div>
              <h2 class="text-right text-sm font-semibold text-accent-normal sm:text-base">
                Nuestro equipo
              </h2>
            </div>
          </div>
        </a>
      </div>

      <div class="py-5 text-center md:py-0">
        <Image
          src={logo}
          alt="Logo centro mundi"
          loading="eager"
          class="m-auto w-28 md:w-14"
          draggable={false}
          quality={80}
        />
      </div>

      <div class="order-first flex items-center justify-end gap-5 md:order-last">
        <a href="https://api.whatsapp.com/send?phone=56959905385" rel="noreferrer" target="_blank">
          <div>
            <h2
              class="text-right text-sm font-semibold text-accent-normal transition-opacity duration-300 ease-in-out hover:opacity-50 sm:text-base"
            >
              Agenda tu asesoría de orientación gratis
            </h2>
          </div>

          <a
            class="animate-pop transition-opacity duration-300 ease-in-out animate-duration-1000 animate-iteration-count-infinite hover:opacity-50"
            href="https://api.whatsapp.com/send?phone=56959905385"
            rel="noreferrer"
            target="_blank"
            aria-label="Agenda tu asesoría de orientación gratis"
          >
            <FaWhatsapp size={42} className="text-[#25D366]" />
          </a>
        </a>
      </div>
    </div>
  </div>
</section>
