---
import type { IconType } from 'react-icons'

interface Props {
  icon: IconType
  title: string
}

const { icon: Icon, title } = Astro.props
---

<div
  class="flex flex-col items-center justify-center transition-all duration-300 ease-in-out hover:-translate-y-2"
>
  <div class="relative my-4">
    <Icon size={48} className="absolute z-10 text-white/75" />
    <div class="h-12 w-12 translate-x-4 translate-y-4 transform rounded-full bg-accent-normal/30">
    </div>
  </div>

  <h2 class="mt-4 mb-2 rounded-md bg-accent-normal px-1 text-lg font-bold text-white">
    {title}
  </h2>

  <ul class="list-inside">
    <slot />
  </ul>
</div>
