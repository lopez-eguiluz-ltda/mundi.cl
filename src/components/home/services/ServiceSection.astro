---
import { detailServices } from '@utils/servicesSeed'
import type { Service } from '@utils/types'
import ItemDescription from './list/ItemDescription.astro'
import ServiceItem from './list/ServiceItem.astro'
---

<section
  class="flex scroll-my-32 flex-col items-start px-10 py-10 select-none md:px-20 md:py-12"
  id="servicios"
>
  <h2 class="rounded-3xl border border-white px-3 py-1 text-sm font-semibold text-white">
    Servicios
  </h2>

  <h2 class="pt-4 pb-10 text-2xl font-bold text-white md:text-4xl">
    Atención de alta calidad para ti
  </h2>

  <div class="flex w-full justify-center">
    <div
      class="grid w-full grid-cols-1 items-start justify-items-center gap-5 py-10 sm:grid-cols-2 md:px-10 lg:w-10/12 lg:grid-cols-3 xl:w-9/12"
    >
      {
        detailServices.map((service: Service) => (
          <ServiceItem icon={service.icon} title={service.service}>
            {service.descriptions.map((description: string) => (
              <ItemDescription description={description} />
            ))}
          </ServiceItem>
        ))
      }
    </div>
  </div>
</section>
