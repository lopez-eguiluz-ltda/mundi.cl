---
import FooterSection from '@components/common/footer/FooterSection.astro'
import Head from '@components/common/Head.astro'
import '@fontsource-variable/quicksand'

import '@styles/global.css'
---

<html lang="es" class="scroll-smooth">
  <Head />
  <body
    class="relative flex min-h-screen w-full flex-col bg-linear-to-br from-primary-normal from-50% to-accent-normal antialiased"
  >
    <main id="inicio">
      <slot />
    </main>

    <FooterSection />
  </body>
</html>
